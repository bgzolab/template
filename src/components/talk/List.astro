---
import "../../assets/css/normalize.css";
import "../../assets/css/talk-style.css";
import "../../assets/css/talk-item.css";
import Item from "../talk/Item.astro";

const { SITE_URL } = Astro.locals;
const SITE_URL_NO_SLASH = SITE_URL.endsWith('/') ? SITE_URL.slice(0, -1) : SITE_URL;
const { channel, before = true, after = true, isItem = false } = Astro.props;
const posts = channel.posts ?? [];

const beforeCursor = posts[posts.length - 1]?.id;
const afterCursor = posts[0]?.id;
---

<div id="main-container">
  <div class="items">
    {posts.map((post: any) => <Item post={post} isItem={isItem} />)}
  </div>

  <div class="pages-container">
    {
      before && beforeCursor > 1 ? (
        <a
          href={`${SITE_URL_NO_SLASH}/talk/before/${beforeCursor}`}
          title="Before"
          class="page"
        >
          Before
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }

    <div class="pages-info"></div>
    {
      after && afterCursor ? (
        <a
          href={`${SITE_URL_NO_SLASH}/talk/after/${afterCursor}`}
          title="After"
          class="page"
        >
          After
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }
  </div>
</div>
