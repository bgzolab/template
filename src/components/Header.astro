---
import { navLinks } from '../config/nav.ts';
const currentPath = Astro.url.pathname;
---

<div class="flex justify-between px-4 py-4 mx-auto sm:px-8 max-w-2xl">
  <nav class="text-gray-700 space-x-4 left-1">
    {navLinks.map(link => (
      // 保持当前页面的链接加粗
      <a href={link.path} class={currentPath === link.path ? 'font-bold' : ''}>{link.name}</a>
    ))}
  </nav>
</div>