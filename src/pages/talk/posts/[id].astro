//     { request: { headers: new Headers() } },
//     {}
//   );
//   const paths = channel.posts.map((post: any) => ({
//     params: { id: post.id },
//   }));
//   return paths;
// }
const channelInfo = await getChannelInfo(Astro);

const post = await getChannelInfo(Astro, {
  type: "post",
  id: (Astro.params as { id: string }).id,
});

const channel = {
  ...(channelInfo || {}),
  posts: [post],
  seo: post,
};

export const prerender = false;
// const staticProxy = getEnv(import.meta.env, Astro, 'STATIC_PROXY') ?? '/static/'
---

<Home>
  <Header />
  <Article>
    <List channel={channel} before={false} after={false} isItem={true} />
  </Article>
  <Footer />
</Home>

