---
import List from "../../../components/talks/List.astro";
import { getChannelInfo } from "../../../lib/telegram";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Home from "../../../layouts/Home.astro";
import Article from "../../../components/Article.astro";

const channelInfo = await getChannelInfo(Astro);

const post = await getChannelInfo(Astro, {
  type: "post",
  id: (Astro.params as { id: string }).id,
});

const channel = {
  ...(channelInfo || {}),
  posts: [post],
  seo: post,
};

export const prerender = false;
---

<Home>
  <Header />
  <Article>
    <List channel={channel} before={false} after={false} isItem={true} />
  </Article>
  <Footer />
</Home>
