#!/usr/bin/env bash
set -e

# Lightweight pre-commit hook sample
# Purpose: block commits that include obvious sensitive filenames or keywords
# Installation: copy this file to .git/hooks/pre-commit and chmod +x

BLACKLIST_PATTERNS=("PRIVATE_KEY" "API_KEY" "SECRET=" "TOKEN=" "id_rsa" "id_ed25519" ".env")
BAD=0
echo "Running lightweight sensitive-file check..."

staged_files=$(git diff --cached --name-only)
if [ -z "$staged_files" ]; then
  exit 0
fi

for f in $staged_files; do
  for p in "${BLACKLIST_PATTERNS[@]}"; do
    if [[ "$f" == *"$p"* ]]; then
      echo "ERROR: staged file matches forbidden pattern: $f (pattern: $p)"
      BAD=1
    fi
  done
  # Check content for suspicious tokens (text files only)
  if git show :"$f" 2>/dev/null | grep -E --line-number -i "(API_KEY|SECRET=|TOKEN=|PRIVATE_KEY)" >/dev/null; then
    echo "ERROR: staged file $f contains suspicious content (API_KEY/SECRET/TOKEN/PRIVATE_KEY)"
    BAD=1
  fi
done

if [ $BAD -ne 0 ]; then
  echo
  echo "Commit blocked by sensitive-file check. Suggestions:"
  echo " - Remove secrets from the commit, or move the file to /home/bgzo/.trash.bak and update references." 
  echo " - To bypass (not recommended): git commit --no-verify"
  exit 1
fi

exit 0
